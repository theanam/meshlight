{
  "name": "meshlight",
  "version": "0.1.0",
  "description": "Browser-based STL mesh inspector that runs 100% offline.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/pipeline.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/meshlight-test.mjs --log-level=warning && node node_modules/.cache/meshlight-test.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "esbuild": "^0.24.0"
  }
}
